require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'

# If CDN fails with "Error in the HTTP2 framing layer", uncomment the next line and run pod install again (first run may take 5–15 min).
# source 'https://github.com/CocoaPods/Specs.git'

podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

ENV['RCT_NEW_ARCH_ENABLED'] = podfile_properties['newArchEnabled'] == 'true' ? '1' : '0'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] = podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']

platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'

# Fix for Firebase Swift pods (GoogleUtilities module map)
use_modular_headers!

install! 'cocoapods',
  :deterministic_uuids => false

prepare_react_native_project!

target 'NomliMingle' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  # Remove react-native-video-trim from iOS (conflicts with ffmpeg-kit-react-native-alt frameworks)
  if config && config[:dependencies]
    config[:dependencies] = config[:dependencies].reject do |dep|
      if dep.is_a?(Hash)
        dep_name = dep[:name] || dep['name'] || dep[:pod] || dep['pod']
        if dep_name && (dep_name.to_s == 'react-native-video-trim' || dep_name.to_s.include?('VideoTrim'))
          puts "⚠️  Removing #{dep_name} - conflicts with ffmpeg-kit-react-native-alt"
          true
        else
          false
        end
      else
        false
      end
    end
  end

  # Use static frameworks to fix Firebase/GoogleUtilities Swift pod compatibility
  use_frameworks! :linkage => :static
  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks'] && podfile_properties['ios.useFrameworks'] != 'static'
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS'] && ENV['USE_FRAMEWORKS'] != 'static'

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => podfile_properties['apple.ccacheEnabled'] == 'true',
    )

    # This is necessary for Xcode 14, because it signs resource bundles by default
    # when building for devices.
    installer.target_installation_results.pod_target_installation_results
      .each do |pod_name, target_installation_result|
      target_installation_result.resource_bundle_targets.each do |resource_bundle_target|
        resource_bundle_target.build_configurations.each do |config|
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        end
      end
    end

    # fmt 11.x + newer Apple Clang (e.g. Xcode 16.2+): consteval format-string checks in
    # format-inl.h fail as "not a constant expression". Compile only the fmt pod as C++17
    # so that path is disabled; the rest of the app/Pods stay on RN's C++20.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'

      target.build_configurations.each do |cfg|
        cfg.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end

    # Strip Finder/iCloud extended attributes — otherwise Release CodeSign can fail with
    # "resource fork, Finder information, or similar detritus not allowed" on pod frameworks.
    pods_dir = installer.sandbox.root.to_s
    Pod::UI.puts 'Stripping extended attributes from Pods (codesign hygiene)…'
    system('chmod', '-R', 'u+w', pods_dir)
    system('/usr/bin/xattr', '-cr', pods_dir)
  end
end
