# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# Avoid @expo/env reading `.env` during Xcode-driven Node (no EXPO_NO_DOTENV from npm there).
# Env for `extra` still comes from `app.config.js`, which loads `.env` / `NOMLI_ENV_FILE` safely.
export EXPO_NO_DOTENV=1

# Xcode script phases use a minimal PATH. RN's with-environment.sh sources this file
# *before* find-node-for-xcode.sh, so nvm/fnm/asdf are not on PATH yet. Load the same
# discovery script first; otherwise NODE_BINARY can stay empty and Hermes script phases fail.
if [ -n "${BASH_VERSION:-}" ] && [ -n "${BASH_SOURCE[0]:-}" ]; then
  _NOMLI_IOS_XCODE_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  _NOMLI_RN_FIND_NODE="$_NOMLI_IOS_XCODE_ENV_DIR/../node_modules/react-native/scripts/find-node-for-xcode.sh"
  if [ -f "$_NOMLI_RN_FIND_NODE" ]; then
    set +e
    # shellcheck disable=SC1090
    . "$_NOMLI_RN_FIND_NODE" || true
    set +e
  fi
  unset _NOMLI_IOS_XCODE_ENV_DIR _NOMLI_RN_FIND_NODE
fi

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm with brew, add the following line
# . "$(brew --prefix nvm)/nvm.sh" --no-use
NODE_CANDIDATE=$(command -v node 2>/dev/null || true)
if [ -n "$NODE_CANDIDATE" ] && [ -x "$NODE_CANDIDATE" ]; then
  export NODE_BINARY="$NODE_CANDIDATE"
elif [ -x /opt/homebrew/bin/node ]; then
  export NODE_BINARY=/opt/homebrew/bin/node
elif [ -x /usr/local/bin/node ]; then
  export NODE_BINARY=/usr/local/bin/node
else
  export NODE_BINARY="$NODE_CANDIDATE"
fi
