    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^4.1.0",
    "react-native-svg-transformer": "^1.5.1",
    "sharp": "^0.34.1",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "fast-glob": "3.3.3",
    "ts-interface-checker": "1.0.2"
  }
}
