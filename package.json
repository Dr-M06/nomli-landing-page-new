{
  "name": "nomli-mingle",
  "main": "index.js",
  "version": "1.0.7",
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-in-app-purchases",
          "expo-location"
        ]
      },
      "ios": {
        "exclude": [
          "expo-location"
        ]
      }
    }
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=16384 expo start --offline",
    "dev:lan": "NODE_OPTIONS=--max-old-space-size=16384 expo start",
    "setup": "node setup.js",
    "start": "NODE_OPTIONS=--max-old-space-size=16384 npx expo start --clear --offline",
    "build:ios": "eas build --platform ios --profile production",
    "build:ios:local": "npx expo run:ios --configuration Release",
    "ios:device:release": "npx expo run:ios --device --configuration Release",
    "build:android": "eas build --platform android --profile production",
    "build:android:local": "npx expo run:android --variant release",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "postinstall": "npx patch-package",
    "clean": "rm -rf node_modules .expo ios/build android/build && npm install",
    "clean-artifacts": "./cleanup.sh",
    "clean-all": "npm run clean-artifacts && npm run clean",
    "fresh-start": "npm run clean && npm run setup && npm run start",
    "prebuild": "npm run clean-artifacts",
    "analyze": "node scripts/analyze-codebase.js",
    "analyze:bundle": "node scripts/optimize-bundle-size.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "~14.0.4",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "4.5.5",
    "@react-native-firebase/app": "^23.5.0",
    "@react-native-firebase/messaging": "^23.5.0",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.50.3",
    "@types/base-64": "^1.0.2",
    "axios": "^1.10.0",
    "base-64": "^1.0.0",
    "base64-arraybuffer": "^1.0.2",
    "buffer": "^6.0.3",
    "debug": "4.3.4",
    "dotenv": "^16.6.1",
    "expo": "~52.0.47",
    "expo-apple-authentication": "~7.1.3",
    "expo-av": "~15.0.2",
    "expo-background-fetch": "~13.0.6",
    "expo-blur": "~14.0.3",
    "expo-camera": "~16.0.18",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-in-app-purchases": "^14.5.0",
