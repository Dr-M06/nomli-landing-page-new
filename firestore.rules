rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    // Admin users have custom claim 'admin: true' set via Firebase Admin SDK
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Influencers collection
    match /influencers/{influencerId} {
      // Allow read if:
      // - From server (API routes - no auth)
      // - Admin users (full access)
      // - User is checking their own document (by document ID match) - works even if doc doesn't exist
      // - User is reading a document where they are the owner (userId field matches)
      // - Influencer is active (for public referral links)
      allow read: if request.auth == null || // Server-side reads (queries)
                     isAdmin() || // Admin can read everything
                     (isAuthenticated() && influencerId == request.auth.uid) || // Allow reading by document ID (their own)
                     (isAuthenticated() && resource != null && resource.data.userId == request.auth.uid) || // Allow reading existing docs where user is owner
                     (isAuthenticated() && resource != null && resource.data.isActive == true); // Allow reading active influencers
      
      // Allow create if user is creating their own record OR from server (no auth)
      allow create: if (isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid) ||
                       request.auth == null; // Allow from server/API routes
      
      // Allow update from server (API routes) or if user is updating their own
      allow update: if request.auth == null || // Server-side writes
                       (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    
    // Referrals collection
    match /referrals/{referralId} {
      // Allow read if:
      // - From server (API routes)
      // - Admin users (full access)
      // - User is the referred user or the influencer
      allow read: if request.auth == null || // Server-side reads
                     isAdmin() || // Admin can read everything
                     (isAuthenticated() && 
                      (resource.data.userId == request.auth.uid || 
                       resource.data.influencerId == request.auth.uid));
      
      // Allow create/update from server (API routes) or authenticated users
      allow create, update: if request.auth == null || // Server-side writes
                               isAuthenticated();
    }
    
    // Milestone payments collection
    match /milestone_payments/{paymentId} {
      // Allow read if:
      // - From server (API routes)
      // - Admin users (full access)
      // - User is the influencer
      allow read: if request.auth == null || // Server-side reads
                     isAdmin() || // Admin can read everything
                     (isAuthenticated() && 
                      resource.data.influencerId == request.auth.uid);
      
      // Allow create/update from server (API routes)
      allow create, update: if request.auth == null || // Server-side writes
                               isAuthenticated();
    }
    
    // Users collection
    match /users/{userId} {
      // Allow read if:
      // - Admin users (full access)
      // - User reading their own data
      allow read: if isAdmin() || 
                     (isAuthenticated() && request.auth.uid == userId);
      allow write: if isAdmin() || 
                      (isAuthenticated() && request.auth.uid == userId);
    }
    
    // Stories collection
    match /stories/{storyId} {
      allow read: if true; // Public read
      allow write: if isAuthenticated() && 
                     request.resource.data.userId == request.auth.uid;
    }
    
    // Posts collection
    match /posts/{postId} {
      allow read: if true; // Public read
      allow write: if isAuthenticated() && 
                     request.resource.data.userId == request.auth.uid;
    }
  }
}

