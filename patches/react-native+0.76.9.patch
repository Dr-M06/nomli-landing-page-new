+/**
+ * Web implementation — RN only ships RCTNetworking.{ios,android}.js
+ */
+'use strict';
+
+const RCTDeviceEventEmitter = require('../EventEmitter/RCTDeviceEventEmitter').default;
+
+let nextId = 1;
+
+function bodyForFetch(data) {
+  if (data == null || data === '') return undefined;
+  if (typeof data === 'string') return data;
+  if (typeof data === 'object' && data.string != null) return data.string;
+  return undefined;
+}
+
+const RCTNetworking = {
+  addListener(eventType, listener, context) {
+    return RCTDeviceEventEmitter.addListener(eventType, listener, context);
+  },
+
+  sendRequest(
+    method,
+    _trackingName,
+    url,
+    headers,
+    data,
+    responseType,
+    _incrementalUpdates,
+    timeout,
+    callback,
+    withCredentials,
+  ) {
+    const requestId = nextId++;
+    callback(requestId);
+
+    const init = {
+      method,
+      headers: headers && typeof headers === 'object' ? { ...headers } : {},
+      credentials: withCredentials ? 'include' : 'same-origin',
+    };
+    const b = bodyForFetch(data);
+    if (b !== undefined && method !== 'GET' && method !== 'HEAD') {
+      init.body = b;
+    }
+
+    const ac = typeof AbortController !== 'undefined' ? new AbortController() : null;
+    const t =
+      ac && typeof timeout === 'number' && timeout > 0
+        ? setTimeout(() => ac.abort(), timeout)
+        : null;
+
+    const done = (err, status, headerObj, urlOut, bodyStr) => {
+      if (t) clearTimeout(t);
+      if (err) {
+        RCTDeviceEventEmitter.emit('didCompleteNetworkResponse', [requestId, String(err), false]);
+        return;
+      }
+      RCTDeviceEventEmitter.emit('didReceiveNetworkResponse', [
+        requestId,
+        status,
+        headerObj || {},
+        urlOut || url,
+      ]);
+      RCTDeviceEventEmitter.emit('didReceiveNetworkData', [requestId, bodyStr || '']);
+      RCTDeviceEventEmitter.emit('didCompleteNetworkResponse', [requestId, null, false]);
+    };
+
+    if (typeof fetch !== 'function') {
+      done(new Error('fetch is not available'));
+      return;
+    }
+
+    fetch(url, ac ? { ...init, signal: ac.signal } : init)
+      .then(async (res) => {
+        const headerObj = {};
+        res.headers.forEach((v, k) => {
+          headerObj[k] = v;
+        });
+        try {
+          let text;
+          if (responseType === 'base64' || responseType === 'blob') {
+            const buf = await res.arrayBuffer();
+            const bytes = new Uint8Array(buf);
+            let binary = '';
+            for (let i = 0; i < bytes.length; i++) {
+              binary += String.fromCharCode(bytes[i]);
+            }
+            text = typeof globalThis.btoa === 'function' ? globalThis.btoa(binary) : '';
+          } else {
+            text = await res.text();
+          }
+          done(null, res.status, headerObj, res.url, text);
+        } catch (e) {
+          done(e);
+        }
+      })
+      .catch((err) => {
+        const msg = err && err.name === 'AbortError' ? 'timeout' : String(err && err.message ? err.message : err);
+        if (t) clearTimeout(t);
+        RCTDeviceEventEmitter.emit('didCompleteNetworkResponse', [requestId, msg, err && err.name === 'AbortError']);
+      });
+  },
+
+  abortRequest(_requestId) {},
+
+  clearCookies(cb) {
+    if (cb) cb(true);
+  },
+};
