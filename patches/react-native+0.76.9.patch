@@ -0,0 +1,25 @@
+/**
+ * Web stub — RN ships BackHandler.{ios,android}.js only (no hardware back).
+ */
+'use strict';
+
+const _subs = [];
+
+const BackHandler = {
+  exitApp() {},
+  addEventListener(_eventName, handler) {
+    _subs.push(handler);
+    return {
+      remove: () => {
+        const i = _subs.indexOf(handler);
+        if (i >= 0) _subs.splice(i, 1);
+      },
+    };
+  },
+  removeEventListener(_eventName, handler) {
+    const i = _subs.indexOf(handler);
+    if (i >= 0) _subs.splice(i, 1);
+  },
+};
+
+module.exports = BackHandler;
