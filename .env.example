# Canonical public URL for sitemap, robots, Open Graph, and JSON-LD (no trailing slash).
# If unset, see `lib/site.ts` for the default.
# NEXT_PUBLIC_SITE_URL=https://nomlimingle.com

# Optional: Google Search Console HTML tag verification content value
# GOOGLE_SITE_VERIFICATION=

# --- Music / Supabase (web player, submissions, admin) ---
# Browser login + music UI need these (NEXT_PUBLIC_* is preferred).
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Optional aliases (see next.config.mjs): SUPABASE_URL, SUPABASE_ANON_KEY — then restart dev server.
# Auth: enable Email provider + Google under Authentication → Providers.
# Add redirect URLs: http://localhost:3000/auth/callback and your production https://your-domain/auth/callback
# Server-only: the "service_role" secret JWT from Supabase → Project Settings → API Keys (legacy/service_role tab if shown)
# (not the anon key, not a database function). Required for /api/admin/music. Never expose in client code.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cover image upload via Supabase Edge → Bunny (see app/api/upload/bunny-image/route.ts)
# BUNNY_EDGE_FUNCTION_NAME=bunny-net-proxy
# BUNNY_EDGE_FUNCTION_URL=https://your-project.supabase.co/functions/v1/bunny-net-proxy
