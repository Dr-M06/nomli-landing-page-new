{
  "cli": {
    "version": ">= 13.2.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "NODE_ENV": "development"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "withoutCredentials": true,
        "image": "ubuntu-22.04-jdk-17-ndk-r26b",
        "cache": {
          "disabled": false,
          "key": "gradle-cache-v2"
        },
        "env": {
          "GRADLE_OPTS": "-Xmx4096m -XX:MaxMetaspaceSize=1024m"
        }
      },
      "ios": {
        "distribution": "internal",
        "buildConfiguration": "Release",
        "credentialsSource": "local"
      },
      "env": {
        "NODE_ENV": "production"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "image": "ubuntu-22.04-jdk-17-ndk-r26b",
        "withoutCredentials": true,
        "cache": {
          "disabled": false,
          "key": "gradle-cache-v1"
        },
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "distribution": "store",
        "buildConfiguration": "Release",
        "simulator": false
      },
      "env": {
        "NODE_ENV": "production"
      },
      "autoIncrement": false
    },
    "standalone": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "withoutCredentials": true,
        "image": "ubuntu-22.04-jdk-17-ndk-r26b",
        "cache": {
          "disabled": false,
          "key": "gradle-cache-v3"
        },
        "env": {
          "GRADLE_OPTS": "-Xmx4096m -XX:MaxMetaspaceSize=1024m"
        }
      },
      "ios": {
        "distribution": "internal",
        "buildConfiguration": "Release"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_NO_DOTENV": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6754324967"
      }
    }
  }
} 