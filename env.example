# ===========================================
# NOMLI MINGLE - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ===========================================
# PUBLIC VARIABLES (Visible in client-side code)
# ===========================================
# These variables are accessible in React Native/Expo client code
# Use EXPO_PUBLIC_ prefix for client-side access

# WhatsApp Support
WHATSAPP_SUPPORT_NUMBER=+1234567890

# Supabase Configuration (REQUIRED)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# CDN Configuration (For faster loading in Nigeria and other regions)
# Set EXPO_PUBLIC_USE_CDN=true to enable CDN
# Set EXPO_PUBLIC_CDN_DOMAIN to your CDN domain
# Example: supabase-cdn.cdnnomliminglecom.workers.dev (Cloudflare Worker)
# Or: cdn.yourdomain.com (custom domain)
# 
# OPTIMIZATION: Direct Supabase URLs with aggressive caching can be faster than CDN
# Set EXPO_PUBLIC_USE_DIRECT_SUPABASE=true to use direct URLs (better caching, faster loads)
# Defaults to true when USE_CDN is false
EXPO_PUBLIC_USE_CDN=false
EXPO_PUBLIC_CDN_DOMAIN=supabase-cdn.cdnnomliminglecom.workers.dev
EXPO_PUBLIC_USE_DIRECT_SUPABASE=true

# Cloudflare CDN Cache Purge (Server-side only - set in Supabase Edge Functions or .env)
# Required for cache purging when avatars/media are updated
# Get these from: https://dash.cloudflare.com -> Your Zone -> Overview -> Zone ID
# API Token: https://dash.cloudflare.com/profile/api-tokens (create token with Zone.Cache Purge permission)
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Bunny.net Storage Configuration (Africa-optimized CDN)
# Get these from: https://bunny.net -> Storage -> Create Storage Zone
# Storage Zone Name: Your storage zone name (e.g., nomli-mingle-images)
# CDN Hostname: Your CDN hostname (e.g., nomli-mingle-images.b-cdn.net)
# Storage Password: Your storage zone password (from Storage Zone settings)
# Set EXPO_PUBLIC_USE_BUNNY_NET=true to enable Bunny.net uploads
EXPO_PUBLIC_USE_BUNNY_NET=false
EXPO_PUBLIC_BUNNY_NET_STORAGE_ZONE=your-storage-zone-name
EXPO_PUBLIC_BUNNY_NET_CDN_HOSTNAME=your-storage-zone.b-cdn.net
EXPO_PUBLIC_BUNNY_NET_STORAGE_PASSWORD=your-storage-password

# Mux Configuration
# Keep MUX_ACCESS_TOKEN_ID + MUX_ACCESS_TOKEN_SECRET in Supabase → Edge Functions → mux-upload → Secrets only.
# Optional: EXPO_PUBLIC_MUX_ACCESS_TOKEN_ID if you need a non-secret id in the client for display/debug (not required for upload).
EXPO_PUBLIC_MUX_ACCESS_TOKEN_ID=
EXPO_PUBLIC_MUX_ASSET_DOMAIN=stream.mux.com

# Stream Chat Configuration
EXPO_PUBLIC_STREAM_API_KEY=your_stream_api_key
EXPO_PUBLIC_STREAM_API_SECRET=your_stream_api_secret

# Location Services
EXPO_GEOAPIFY_API_KEY=your_geoapify_key

# Flutterwave Payment (Nigeria)
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
# Note: Secret keys should be set in Supabase Edge Functions environment, not here

# ===========================================
# SERVER-SIDE VARIABLES (NOT visible in client)
# ===========================================
# These variables are only accessible on the server-side
# Use without EXPO_PUBLIC_ prefix for security

# Flutterwave Secret Keys (Server-side only - set in Supabase Dashboard)
# FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
# FLUTTERWAVE_SECRET_HASH=your_flutterwave_secret_hash
# FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key

# Agora Configuration (SECURE - Server-side only)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Token Server Configuration
AGORA_TOKEN_SERVER_URL=https://your-token-server.com

# ===========================================
# DEVELOPMENT OVERRIDES (Optional)
# ===========================================
# These are for development/testing only
# Remove or comment out for production

# Development Agora App ID (TEMPORARY - NOT SECURE)
# EXPO_PUBLIC_AGORA_APP_ID=your_dev_app_id

# Development Token Server
# EXPO_PUBLIC_AGORA_TOKEN_SERVER_URL=http://localhost:3001
